# Application
DEBUG=True
SECRET_KEY=replace-this-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=UTC
LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Django MySQL connection
DB_NAME=tokenledger
DB_USER=tokenledger
DB_PASSWORD=replace-this-with-a-strong-database-password
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Docker MySQL initialization
MYSQL_DATABASE=tokenledger
MYSQL_USER=tokenledger
MYSQL_PASSWORD=replace-this-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-this-with-a-strong-root-password
